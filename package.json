{
  "name": "find-my-ai-worldview",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "tokens": "node scripts/build-tokens.mjs",
    "e2e": "playwright test",
    "dev:lan": "next dev -H 0.0.0.0",
    "share": "node scripts/share.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "db:up": "docker compose up -d --wait && node scripts/db-local.mjs migrate",
    "db:seed": "tsx --conditions=react-server scripts/seed-local.mts",
    "load-test": "tsx scripts/load-test.mts",
    "db:reset": "node scripts/db-local.mjs reset",
    "db:down": "docker compose down",
    "content:freeze": "node scripts/freeze-content.mjs",
    "publish:public": "node scripts/publish-public.mjs",
    "withdraw": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/withdraw.ts",
    "launch-check": "LAUNCH_CHECK=1 vitest run"
  },
  "dependencies": {
    "@vercel/analytics": "2.0.1",
    "@vercel/speed-insights": "2.0.0",
    "fflate": "0.8.3",
    "next": "16.4.0",
    "postgres": "3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/turbopack": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.4"
  }
}
